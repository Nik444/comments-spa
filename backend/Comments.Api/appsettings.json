{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Comments": {
    "PageSize": 25,
    "MaxRepliesPerThread": 1000,
    "MaxIdsPerRequest": 200
  },
  "Cache": {
    "Mode": "Memory",
    "HeadPages": 5,
    "TailPages": 5,
    "PageLocalSeconds": 2,
    "PageRedisSeconds": 2,
    "CommentLocalMinutes": 5,
    "CommentRedisMinutes": 60,
    "CommentLocalMaxItems": 50000
  },
  "RabbitMq": {
    "Enabled": true,
    "Host": "localhost",
    "Port": 5672,
    "QueueCapacity": 10000
  },
  "Captcha": {
    "Enabled": true,
    "CodeLength": 5,
    "LifetimeMinutes": 5,
    "MaxStoredCodes": 100000
  },
  "AllowedHosts": "*"
}
