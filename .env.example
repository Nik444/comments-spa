# Образец файла окружения. Скопируйте в .env (локально) или .env.azure (сервер); файлы с секретами в Git не попадают.
# Без файла docker compose использует значения по умолчанию, они подходят только для локальной разработки.

# Порт сайта на хосте (по умолчанию 8080, на сервере 80).
WEB_PORT=8080

# Пароли контейнеров. По умолчанию dev-значения. На сервере задайте свои: только буквы и цифры,
# для SQL Server минимум 8 символов с заглавными, строчными и цифрами.
# Пароль применяется при первом создании тома: чтобы сменить его позже, том нужно удалить (docker compose down -v).
MSSQL_SA_PASSWORD=
RABBITMQ_PASSWORD=

# Хранилище вложений: Local (том Docker) или AzureBlob.
STORAGE_PROVIDER=Local
# Для AzureBlob без секретов (рекомендуется): адрес Blob-службы. Нужна управляемая идентификация VM
# с ролью "Storage Blob Data Contributor" на аккаунте или контейнере.
AZURE_STORAGE_SERVICE_URI=
# Либо строка подключения с ключом аккаунта (работает, только если ключи на аккаунте разрешены).
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=uploads
# Минуты хранения файлов в кэше перед хранилищем (Redis). 0 = выключено. Имеет смысл для AzureBlob.
STORAGE_CACHE_MINUTES=0

# Капча: true по умолчанию. false только для ручной проверки.
CAPTCHA_ENABLED=true
